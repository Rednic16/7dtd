      <property name="MoveSpeedAggro" value="1.1, 1.3"/>
      <property class="ItemsOnEnterGame">
        <property name="GameModeSurvival" value="meleeWpnClubT0WoodenClub"/>
        <property name="GameModeSurvivalSP" value="meleeWpnClubT0WoodenClub"/>
        <property name="GameModeSurvivalMP" value="meleeWpnClubT0WoodenClub"/>
      </property>
      <effect_group name="Base Effects">
        <passive_effect name="HealthMax" operation="base_set" value="150"/>
      </effect_group>
    </entity_class>
    <entity_class name="dhsBanditMotor" extends="dhsBanditTemplate">
